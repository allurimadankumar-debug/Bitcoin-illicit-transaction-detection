# ---------------------------------------------------------------------------
# Copy to .env and edit. Never commit real credentials.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Bitcoin Illicit Transaction Detection"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Backend / API
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage (relative paths are resolved from the project root)
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data
MODELS_DIR=./models
REPORTS_DIR=./reports

# Dataset selection: auto | elliptic | demo
DATASET_SOURCE=auto
DEMO_TRANSACTIONS=360
DEMO_TIME_STEPS=40

# Machine learning
# Set to false if you want to train manually before predictions work.
AUTO_TRAIN_DEMO=true
CALIBRATE_MODEL=true
RANDOM_STATE=42
TRAIN_FRACTION=0.70
VALIDATION_FRACTION=0.15
# Oversampling is disabled by default; class weights are used instead.
USE_OVERSAMPLING=false
# Automatic selection uses validation PR-AUC. To deploy Random Forest explicitly:
# python backend/ml/train.py --source demo --model random_forest

# Privacy
MASK_IDS_BY_DEFAULT=false
# Bitcoin transactions are pseudonymous. This app never asks for keys.
ENABLE_LIVE_LOOKUP=false
LIVE_LOOKUP_TIMEOUT=8
EXPLORER_BASE_URL=https://blockstream.info/tx
# Optional public explorer API base (only used when ENABLE_LIVE_LOOKUP=true)
EXPLORER_API_BASE_URL=https://blockstream.info/api

# Kaggle credentials are intentionally NOT stored here.
# Use ~/.kaggle/kaggle.json or environment variables when running the
# optional download script (see docs/KAGGLE_SETUP.md).
